# ═══════════════════════════════════════════════════════════
# Leon Bookmarks - Docker Compose Environment Variables
# Copy this file: cp .env.docker.example .env.docker
# Then edit values as needed.
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=leon_bookmarks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379

# ── Meilisearch ──
MEILI_MASTER_KEY=masterKey123
MEILI_ENV=development
MEILI_PORT=7700

# ── MinIO (S3-Compatible Storage) ──
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── API (Nest.js) ──
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Stripe (optional — billing runs in mock mode without these) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

